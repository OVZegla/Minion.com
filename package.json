{
  "name": "minion-com",
  "version": "1.0.0",
  "private": true,
  "description": "Ton espace pour organiser tes cours, tes révisions et tes études.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "qa:smoke": "node qa/smoke.mjs",
    "qa:scenarios": "node qa/scenarios.mjs",
    "qa:autosave": "node qa/autosave.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "electron .",
    "desktop:dev": "npm run desktop:build && electron .",
    "dist:win": "npm run desktop:build && electron-builder --win --publish never",
    "dist:linux": "npm run desktop:build && electron-builder --linux --publish never",
    "dist:mac": "npm run desktop:build && electron-builder --mac --publish never",
    "qa:desktop": "node qa/desktop.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.34.0",
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "main": "electron/main.cjs",
  "author": "minion.com"
}
